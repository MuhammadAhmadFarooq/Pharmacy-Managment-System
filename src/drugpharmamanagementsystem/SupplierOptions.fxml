<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: FFFFF;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.SupplierOptionsController">
   <children>
      <ImageView fitHeight="365.0" fitWidth="346.0" layoutX="-38.0" layoutY="43.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../SupplierImage/supplier-vector-46631676.jpg" />
         </image>
      </ImageView>
      <Label layoutX="221.0" layoutY="50.0" text="Supplier Options">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button fx:id="ordersButton" layoutX="229.0" layoutY="147.0" mnemonicParsing="false" onAction="#ordersClicked" text="View Received Orders" />
      <Button fx:id="completeOrdersButton" layoutX="195.0" layoutY="200.0" mnemonicParsing="false" onAction="#completeOrdersIsClicked" text="Complete Orders and add to Stock" />
   </children>
</AnchorPane>
