<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.IssueOrdersController">
   <children>
      <Label layoutX="187.0" layoutY="23.0" text="Issue Orders to Supplier">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="170.0" layoutY="72.0" text="Enter Item ID:" />
      <TextField fx:id="itemID" layoutX="170.0" layoutY="103.0" />
      <Label layoutX="170.0" layoutY="137.0" text="Enter Order Quantity:" />
      <TextField fx:id="quantity" layoutX="170.0" layoutY="168.0" />
      <Label layoutX="170.0" layoutY="205.0" text="Enter Supplier ID:" />
      <TextField fx:id="supplierID" layoutX="170.0" layoutY="236.0" />
      <Label layoutX="170.0" layoutY="270.0" text="Enter your Pharmacist ID:" />
      <TextField fx:id="pharmID" layoutX="170.0" layoutY="301.0" />
      <Button fx:id="orderButton" layoutX="223.0" layoutY="338.0" mnemonicParsing="false" onAction="#orderButtonClicked" text="Issue Order" />
   </children>
</AnchorPane>
