<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="drugpharmamanagementsystem.ViewPrescriptionsController">
   <children>
      <Label layoutX="213.0" layoutY="25.0" text="View Prescriptions">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="patientID" layoutX="106.0" layoutY="174.0" />
      <TextField fx:id="prescriptionID" layoutX="106.0" layoutY="94.0" />
      <Label layoutX="106.0" layoutY="63.0" text="Prescription ID:" />
      <Label layoutX="106.0" layoutY="142.0" text="Patient ID:" />
      <Button fx:id="enterButton" layoutX="278.0" layoutY="204.0" mnemonicParsing="false" onAction="#isClicked" text="Enter" />
      <TableView fx:id="tableView" layoutX="35.0" layoutY="241.0" prefHeight="219.0" prefWidth="529.0">
        <columns>
          <TableColumn fx:id="prescriptionid" prefWidth="120.0" text="Prescription ID" />
          <TableColumn fx:id="itemID" prefWidth="75.0" text="Item ID" />
            <TableColumn fx:id="patientid" prefWidth="75.0" text="Patient ID" />
            <TableColumn fx:id="details" minWidth="-1.0" prefWidth="200.0" text="Details" />
            <TableColumn fx:id="quantity" minWidth="-1.0" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="isPaid" prefWidth="75.0" text="is_paid" />
            <TableColumn fx:id="doctorID" prefWidth="75.0" text="Doctor ID" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
