<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.PrescriptionDetailsController">
   <children>
      <Label layoutX="205.0" layoutY="52.0" text="Prescription Details">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="120.0" layoutY="100.0" text="Item ID:" />
      <Label fx:id="itemIdLabel" layoutX="220.0" layoutY="100.0" />
      <Label layoutX="120.0" layoutY="130.0" text="Patient ID:" />
      <Label fx:id="patientIdLabel" layoutX="220.0" layoutY="130.0" />
      <Label layoutX="120.0" layoutY="160.0" text="Details:" />
      <Label fx:id="detailsLabel" layoutX="220.0" layoutY="160.0" />
      <Label layoutX="120.0" layoutY="190.0" text="Quantity:" />
      <Label fx:id="quantityLabel" layoutX="220.0" layoutY="190.0" />
      <Label layoutX="120.0" layoutY="220.0" text="Total Cost:" />
      <Label fx:id="totalCostLabel" layoutX="220.0" layoutY="220.0" />
      <Button fx:id="proceedWithPaymentButton" layoutX="220.0" layoutY="250.0" mnemonicParsing="false" onAction="#proceedWithPayment" text="Proceed with Payment" />
   </children>
</AnchorPane>
