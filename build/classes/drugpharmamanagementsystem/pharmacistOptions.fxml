<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="drugpharmamanagementsystem.PharmacistOptionsController">
   <children>
      <ImageView fitHeight="310.0" fitWidth="503.0" layoutX="49.0" layoutY="45.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../PharmacistImage/Pharmacy-Illustration-AI.jpg" />
         </image>
      </ImageView>
      <Label layoutX="208.0" layoutY="30.0" text="Pharmacist Options">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button fx:id="inventoryButton" layoutX="78.0" layoutY="127.0" mnemonicParsing="false" onAction="#inventoryClicked" text="View Inventory" />
      <Button fx:id="ViewPrescriptionButton" layoutX="78.0" layoutY="161.0" mnemonicParsing="false" onAction="#viewPrescriptionsClicked" text="View Prescriptions" />
      <Button fx:id="issueOrdersButton" layoutX="81.0" layoutY="233.0" mnemonicParsing="false" onAction="#issueOrdersClicked" text="Issue Orders to Supplier" />
      <Button fx:id="lowStockButton" layoutX="81.0" layoutY="200.0" mnemonicParsing="false" onAction="#stockButtonClicked" text="Check Low Stock Alerts" />
      <Button fx:id="processPaymentButton" layoutX="81.0" layoutY="272.0" mnemonicParsing="false" onAction="#processPaymentClicked" text="Process Payments" />
   </children>
</AnchorPane>
