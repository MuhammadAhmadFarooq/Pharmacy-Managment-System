<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.CompleteOrdersController">
   <children>
      <Label layoutX="88.0" layoutY="44.0" text="Complete Orders and Add to Inventory Stock">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="88.0" layoutY="135.0" text="Enter order ID:" />
      <TextField fx:id="orderID" layoutX="88.0" layoutY="163.0" />
      <Label layoutX="90.0" layoutY="210.0" text="Enter item ID:" />
      <TextField fx:id="itemID" layoutX="90.0" layoutY="238.0" />
      <Button fx:id="CompleteOrderButton" layoutX="249.0" layoutY="310.0" mnemonicParsing="false" onAction="#completeIsClicked" text="Complete Order" />
   </children>
</AnchorPane>
