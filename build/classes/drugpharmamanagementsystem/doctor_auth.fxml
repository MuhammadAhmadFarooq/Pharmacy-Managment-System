<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.Doctor_authController">
   <children>
      <Label layoutX="200.0" layoutY="65.0" text="Doctor Authorization">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="200.0" layoutY="126.0" text="License Number:" />
      <TextField fx:id="license_no" layoutX="200.0" layoutY="154.0" prefHeight="25.0" prefWidth="159.0" promptText="Enter your license number" />
      <Label layoutX="200.0" layoutY="190.0" text="Last Name:" />
      <TextField fx:id="l_name" layoutX="200.0" layoutY="218.0" prefHeight="25.0" prefWidth="159.0" promptText="Enter your last name" />
      <Button fx:id="loginButton" layoutX="263.0" layoutY="272.0" mnemonicParsing="false" onAction="#loginButtonIsClicked" text="Login" />
   </children>
</AnchorPane>
