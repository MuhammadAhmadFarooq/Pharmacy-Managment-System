<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.ProcessPaymentsController">
   <children>
      <Label layoutX="205.0" layoutY="52.0" text="Payment Processing">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="205.0" layoutY="127.0" text="Patient ID:" />
      <TextField fx:id="patientId" layoutX="205.0" layoutY="155.0" prefHeight="25.0" prefWidth="146.0" promptText="Enter Valid Patient ID" />
      <Label layoutX="205.0" layoutY="200.0" text="Prescription ID:" />
      <TextField fx:id="prescriptionId" layoutX="205.0" layoutY="228.0" prefHeight="25.0" prefWidth="207.0" promptText="Enter Corresponding Prescription ID" />
      <Button fx:id="processPaymentButton" layoutX="256.0" layoutY="281.0" mnemonicParsing="false" onAction="#processPaymentButtonIsClicked" text="Process Payment" />
   </children>
</AnchorPane>
