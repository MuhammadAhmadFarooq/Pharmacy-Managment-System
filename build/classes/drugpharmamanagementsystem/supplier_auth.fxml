<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="drugpharmamanagementsystem.Supplier_authController">
   <children>
      <Label layoutX="193.0" layoutY="46.0" text="Supplier Authorization">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="128.0" layoutY="134.0" text="Supplier ID:" />
      <TextField fx:id="supplierID" layoutX="128.0" layoutY="162.0" promptText="Enter your Supplier ID" />
      <Label layoutX="128.0" layoutY="200.0" text="Supplier Name:" />
      <TextField fx:id="supplierName" layoutX="128.0" layoutY="228.0" promptText="Enter the Supplier Name" />
      <Button fx:id="loginButton" layoutX="252.0" layoutY="301.0" mnemonicParsing="false" onAction="#loginIsClicked" text="Login" />
   </children>
</AnchorPane>
